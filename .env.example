# ---------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- PostgreSQL ---
POSTGRES_USER=hospital
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hospital_noshow
# "localhost" when running the backend on your machine; docker compose overrides it to "postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full URL overrides the POSTGRES_* parts
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Bootstrap admin account created by the seed script
FIRST_ADMIN_EMAIL=admin@citygeneral.org
# Optional: also create staff@citygeneral.org and doctor@citygeneral.org with this password
DEMO_USERS_PASSWORD=
FIRST_ADMIN_PASSWORD=change-me-admin-password

# --- ML risk thresholds (probability upper bounds) ---
RISK_LOW_MAX=0.30
RISK_MEDIUM_MAX=0.60
AUTO_PREDICT_ON_BOOKING=true

# --- GenAI provider: anthropic | openai | none ---
# "none" keeps the assistant working with grounded template responses (no external calls).
# "anthropic" uses the official SDK; default model claude-opus-5-5.
# "openai" works with any OpenAI-compatible endpoint (set LLM_BASE_URL for Azure/Groq/Ollama/etc.).
LLM_PROVIDER=none
# Groq example: LLM_PROVIDER=openai, LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-120b, LLM_MAX_TOKENS=4000
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=16000
# Anthropic: reasoning effort (low|medium|high|xhigh|max). OpenAI-compatible: temperature.
LLM_EFFORT=medium
LLM_TEMPERATURE=0.3

# --- Hospital details used in patient reminders ---
HOSPITAL_NAME=City General Hospital
HOSPITAL_PHONE=+1-555-0100
